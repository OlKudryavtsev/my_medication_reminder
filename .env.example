# Required
BOT_TOKEN=123456:replace_me

# Railway PostgreSQL usually injects DATABASE_URL automatically after adding Postgres.
# Local fallback example:
DATABASE_URL=sqlite+aiosqlite:///./medkid.db

# Public HTTPS URL of this Railway service, without trailing slash.
# Example: https://medkid-bot-production.up.railway.app
APP_BASE_URL=

# Comma-separated Telegram numeric chat IDs of parents.
# You can get your ID by sending /start to the bot; it will show it.
PARENT_CHAT_IDS=

# Optional child Telegram user/chat ID. If empty, reminders go only to parents until configured.
CHILD_CHAT_ID=

TIMEZONE=Europe/Berlin
REMINDER_INTERVAL_MINUTES=7

DEFAULT_BREAKFAST_TIME=08:00
DEFAULT_LUNCH_TIME=13:30
DEFAULT_DINNER_TIME=19:30
